{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.md", "!tools/backlog/created.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 50, "skipBlankLines": true }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "security": { "noDangerouslySetInnerHtml": "error" },
      "style": {
        "noDefaultExport": "error",
        "noProcessEnv": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 300, "skipBlankLines": true }
        }
      },
      "suspicious": { "noExplicitAny": "error", "noConsole": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.config.ts", "**/*.config.mjs", "**/*.config.js"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["apps/api/src/config.ts", "apps/web/vite.config.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["tools/**"],
      "linter": {
        "rules": { "suspicious": { "noConsole": "off" }, "style": { "noProcessEnv": "off" } }
      }
    }
  ]
}
