# Required — the app's public origin (browser-visible URL).
# Locally this is usually the Vite dev server since that's what the browser sees.
APP_URL=http://localhost:5173

# Required — MongoDB Atlas (or local) connection string (DESIGN 11.4).
# Use database money-manager-dev locally; money-manager in production (chosen in code from NODE_ENV).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# Optional — defaults to 3000 locally; set by Railway in production.
# PORT=3000

# Optional — development | production | test. Defaults to development.
# Set to production in Railway; the database name follows it (DESIGN 11.4).
# NODE_ENV=development

# Optional — fatal | error | warn | info | debug | trace | silent. Defaults to info.
# LOG_LEVEL=debug

# --- Added in issue #16 (auth) ---
# BETTER_AUTH_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Added in issue #16 (rate limits) ---
# RATE_LIMIT_API=300
# RATE_LIMIT_AUTH=30
