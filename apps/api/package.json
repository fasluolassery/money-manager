{
  "name": "@money-manager/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "gen:openapi": "tsx --tsconfig tsconfig.json src/gen-openapi.ts && pnpm exec biome format --write ../../docs/openapi.json"
  },
  "dependencies": {
    "@money-manager/shared": "workspace:*",
    "awilix": "^12.1.1",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "mongodb": "^6.22.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
