{
  "name": "@money-manager/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit",
    "check:tokens": "node ../../tools/check-tokens.mjs"
  },
  "size-limit": [
    {
      "name": "Initial JS",
      "path": "dist/assets/index-*.js",
      "limit": "200 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@money-manager/shared": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-query": "^5.64.1",
    "better-auth": "1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.469.0",
    "motion": "^14.14.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router": "^7.1.3",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^11.1.6",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.1",
    "size-limit": "^11.1.6",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
