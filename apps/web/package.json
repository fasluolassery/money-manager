{
  "name": "@money-manager/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Initial JS",
      "path": "dist/assets/*.js",
      "limit": "200 KB",
      "gzip": true
    }
  ],
  "dependencies": {
    "@money-manager/shared": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.64.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.3",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^11.1.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "size-limit": "^11.1.6",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
